{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open States API v3 bills events API",
    "version": "2021.11.12"
  },
  "items": [
    {
      "info": {
        "name": "events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Event List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/events",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "jurisdiction",
                "value": "",
                "type": "query",
                "description": "Filter by jurisdiction name or ID."
              },
              {
                "name": "deleted",
                "value": "",
                "type": "query",
                "description": "Return events marked as deleted?"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Limit results to those starting before a given datetime."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Limit results to those starting after a given datetime."
              },
              {
                "name": "require_bills",
                "value": "",
                "type": "query",
                "description": "Limit results to events with associated bills."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Additional includes for the Event response."
              },
              {
                "name": "apikey",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Event List"
        },
        {
          "info": {
            "name": "Event Detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/events/:event_id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "event_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Additional includes for the Event response."
              },
              {
                "name": "apikey",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get details on a single event by ID."
        }
      ]
    }
  ],
  "bundled": true
}