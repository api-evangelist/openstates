{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open States API v3 bills jurisdictions API",
    "version": "2021.11.12"
  },
  "items": [
    {
      "info": {
        "name": "jurisdictions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Jurisdiction List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/jurisdictions",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "classification",
                "value": "",
                "type": "query",
                "description": "Filter returned jurisdictions by type."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Additional information to include in response."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "apikey",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get list of supported Jurisdictions, a Jurisdiction is a state or municipality."
        },
        {
          "info": {
            "name": "Jurisdiction Detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/jurisdictions/:jurisdiction_id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "jurisdiction_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Additional includes for the Jurisdiction response."
              },
              {
                "name": "apikey",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get details on a single Jurisdiction (e.g. state or municipality)."
        }
      ]
    }
  ],
  "bundled": true
}