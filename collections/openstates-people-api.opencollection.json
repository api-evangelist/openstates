{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open States API v3 bills people API",
    "version": "2021.11.12"
  },
  "items": [
    {
      "info": {
        "name": "people",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "People Search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/people",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "jurisdiction",
                "value": "",
                "type": "query",
                "description": "Filter by jurisdiction name or id."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by name, case-insensitive match."
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Filter by id, can be specified multiple times for multiple people."
              },
              {
                "name": "org_classification",
                "value": "",
                "type": "query",
                "description": "Filter by current role."
              },
              {
                "name": "district",
                "value": "",
                "type": "query",
                "description": "Filter by district name."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Additional information to include in response."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "apikey",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get list of people matching selected criteria.\n\nMust provide either **jurisdiction**, **name**, or one or more **id** parameters."
        },
        {
          "info": {
            "name": "People Geo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/people.geo",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "lat",
                "value": "",
                "type": "query",
                "description": "Latitude of point."
              },
              {
                "name": "lng",
                "value": "",
                "type": "query",
                "description": "Longitude of point."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Additional information to include in the response."
              },
              {
                "name": "apikey",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get list of people currently representing a given location.\n\n**Note:** Currently limited to state legislators and US Congress.  Governors & mayors are not included."
        }
      ]
    }
  ],
  "bundled": true
}